# CodeSphere Ultimate Zero-Setup Online VS Code Web IDE
FROM codercom/code-server:latest

USER root

# Install Python 3, Node.js, NPM, C/C++ GCC/G++, Java, Go, Rust, PHP, Ruby, Git, & Tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    python-is-python3 \
    nodejs \
    npm \
    gcc \
    g++ \
    gdb \
    make \
    cmake \
    build-essential \
    default-jdk \
    golang \
    rustc \
    cargo \
    php-cli \
    ruby \
    git \
    curl \
    wget \
    zip \
    unzip \
    htop \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install global TypeScript, TS-Node, Yarn
RUN npm install -g typescript ts-node yarn

USER coder

# Pre-install essential VS Code Extensions for instant one-click execution
RUN code-server --install-extension formulahendry.code-runner || true \
    && code-server --install-extension esbenp.prettier-vscode || true
