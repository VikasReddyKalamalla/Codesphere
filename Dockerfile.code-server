# CodeSphere Ultimate Zero-Setup Online VS Code Web IDE
FROM codercom/code-server:latest

USER root

# Install Python 3, Node.js, NPM, C/C++ GCC/G++, Java, Go, Rust, PHP, Ruby, Git, & Tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    python-is-python3 \
    nodejs \
    npm \
    gcc \
    g++ \
    gdb \
    make \
    cmake \
    build-essential \
    default-jdk \
    golang \
    rustc \
    cargo \
    php-cli \
    ruby \
    git \
    curl \
    wget \
    zip \
    unzip \
    htop \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install global TypeScript, TS-Node, Yarn
RUN npm install -g typescript ts-node yarn

USER coder

# Pre-install essential VS Code Extensions for instant one-click execution & Live Preview
RUN code-server --install-extension formulahendry.code-runner || true \
    && code-server --install-extension ms-vscode.live-server || true \
    && code-server --install-extension ritwickdey.liveserver || true \
    && code-server --install-extension esbenp.prettier-vscode || true \
    && code-server --install-extension ms-python.python || true

# Pre-configure User settings.json and root auto-redirect index.html for instant Live Server preview
RUN mkdir -p /home/coder/.local/share/code-server/User /home/coder/.config/code-server/User \
    && echo '{\n\
  "code-runner.runInTerminal": true,\n\
  "code-runner.saveFileBeforeRun": true,\n\
  "code-runner.clearPreviousOutput": true,\n\
  "liveServer.settings.donotShowInfoMsg": true,\n\
  "liveServer.settings.donotVerifyTags": true,\n\
  "liveServer.settings.useLocalIp": false,\n\
  "liveServer.settings.fullReload": true,\n\
  "livePreview.autoRefreshPreview": "onAnyChange",\n\
  "livePreview.openPreviewTarget": "EmbeddedPreviewBrowser",\n\
  "livePreview.showServerStatusNotifications": false\n\
}' > /home/coder/.local/share/code-server/User/settings.json \
    && cp /home/coder/.local/share/code-server/User/settings.json /home/coder/.config/code-server/User/settings.json \
    && echo '<!DOCTYPE html><html><head><meta charset="UTF-8"><title>CodeSphere Live Server</title><script>if (window.location.pathname === "/proxy/5500/" || window.location.pathname === "/proxy/5500" || window.location.pathname === "/") { window.location.replace("/proxy/5500/python/index.html"); }</script></head><body><h2>Redirecting to HTML Preview...</h2><script>window.location.replace("/proxy/5500/python/index.html");</script></body></html>' > /home/coder/index.html
