# CodeSphere Complete VS Code Web (code-server) Dockerfile
FROM codercom/code-server:latest

USER root

# Install Python 3, Python Pip, Node.js, NPM, GCC, G++, Git, Curl, and Build Essentials
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python-is-python3 \
    nodejs \
    npm \
    build-essential \
    gcc \
    g++ \
    gdb \
    git \
    curl \
    wget \
    zip \
    unzip \
    && rm -rf /var/lib/apt/lists/*

USER coder
