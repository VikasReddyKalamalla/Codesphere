# ─── Server Configuration ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
HOST=localhost

# ─── Database Configuration ────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/codesphere
MONGO_URI_PROD=mongodb+srv://user:password@cluster.mongodb.net/codesphere

# ─── JWT Configuration ────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_refresh_token_secret
JWT_REFRESH_EXPIRE=30d

# ─── Judge0 Code Execution ────────────────────────────────────────────────────
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your_judge0_api_key_here
JUDGE0_HOST=judge0-ce.p.rapidapi.com

# ─── Redis Configuration (for Socket.io adapter & caching) ──────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
UPSTASH_REDIS_URL=redis://default:password@host:port

# ─── Email Configuration ──────────────────────────────────────────────────────
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
SENDGRID_API_KEY=your_sendgrid_key
AWS_SES_REGION=us-east-1
AWS_SES_ACCESS_KEY=
AWS_SES_SECRET_KEY=
RESEND_API_KEY=

# ─── Payment Configuration (Stripe) ────────────────────────────────────────────
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── File Storage Configuration ────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=codesphere-uploads
S3_CLOUDFRONT_URL=https://d123456.cloudfront.net

# ─── Cloudinary Storage ────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=ywik5ok0
CLOUDINARY_API_KEY=748759357567371
CLOUDINARY_API_SECRET=urZr0KFHLLdFIbxFmmuwuXIBqe0
CLOUDINARY_URL=cloudinary://748759357567371:urZr0KFHLLdFIbxFmmuwuXIBqe0@ywik5ok0

# ─── Video Streaming Configuration (Agora/LiveKit) ──────────────────────────
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
LIVEKT_API_URL=
LIVEKT_API_KEY=

# ─── Monitoring & Logging ─────────────────────────────────────────────────────
SENTRY_DSN=
DATADOG_API_KEY=
LOG_LEVEL=info

# ─── CORS Configuration ────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ─── Feature Flags ─────────────────────────────────────────────────────────────
ENABLE_JUDGE0=true
ENABLE_VIDEO_STREAMING=true
ENABLE_FILE_UPLOAD=true
ENABLE_EMAIL_NOTIFICATIONS=true

# ─── Google OAuth (Optional) ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# ─── GitHub OAuth (Optional) ───────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Domain & SSL ──────────────────────────────────────────────────────────────
DOMAIN=localhost
SSL_ENABLED=false
SSL_CERT_PATH=
SSL_KEY_PATH=

# ─── Cloudinary Storage (Required for cross-developer uploads) ───────────────
CLOUDINARY_CLOUD_NAME=ywik5ok0
CLOUDINARY_API_KEY=748759357567371
CLOUDINARY_API_SECRET=urZr0KFHLLdFIbxFmmuwuXIBqe0
CLOUDINARY_URL=cloudinary://748759357567371:urZr0KFHLLdFIbxFmmuwuXIBqe0@ywik5ok0
